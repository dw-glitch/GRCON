{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": true,
    "jsx": "react",
    "baseUrl": ".",
    "skipLibCheck": true
  },
  "include": ["src/react/consultas/**/*.js"],
  "exclude": ["node_modules", "workers"]
}
