{
  "name": "grcon-cloudflare",
  "keep_vars": true,
  "compatibility_date": "2026-09-24",
  "main": "./cloudflare/worker-entry.mjs",
  "vars": {
    "SUPABASE_URL": "https://kvyrttccwzdhasplfxnr.supabase.co",
    "R2_BUCKET_NAME": "grcon-documents"
  },
  "r2_buckets": [
    {
      "binding": "GRCON_DOCUMENTS",
      "bucket_name": "grcon-documents"
    }
  ],
  "triggers": { "crons": ["17 5 * * *", "* * * * *"] },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
