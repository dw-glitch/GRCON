{
  "name": "grcon-cloudflare",
  "keep_vars": true,
  "compatibility_date": "2026-09-24",
  "main": "./cloudflare/worker-runtime.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {"binding": "AI"},
  "observability": {"enabled": true},
  "workflows": [{"name": "grcon-tasks", "binding": "GRCON_TASKS", "class_name": "GrconTaskWorkflow"}],
  "services": [{"binding":"GRCON_MIGRATION_SELF","service":"grcon-cloudflare"}],
  "vars": {
    "GRCON_SIGEM_STORAGE_MODE": "supabase",
    "GRCON_SIGEM_DIRECT_IMPORTS_ENABLED": "true",
    "GRCON_SIGEM_RELEASE_ENABLED": "true",
    "GRCON_DOCUMENT_UPLOADS_ENABLED": "false",
    "GRCON_SIGEM_EXTERNAL_STORAGE_AUTHORIZED": "true",
    "GRCON_SIGEM_MIGRATION_PREFLIGHT_APPROVED": "true",
    "GRCON_DOCUMENT_AI_ENABLED": "true",
    "SUPABASE_URL": "https://kvyrttccwzdhasplfxnr.supabase.co",
    "R2_BUCKET_NAME": "grcon-documents",
    "GRCON_TEAMS_TRANSPORT": "github",
    "GRCON_TEAMS_TRACEABILITY_ENABLED": "false",
    "GRCON_TEAMS_GITHUB_REPOSITORY": "dw-glitch/GRCON-Teams-Retorno",
    "GRCON_TEAMS_GITHUB_REPOSITORY_ID": "1416220792",
    "GRCON_TEAMS_GITHUB_OWNER_ID": "202873892",
    "GRCON_MICROSOFT_TENANT_ID": "9f250032-dc8e-488c-b733-d6b3ef6e8685",
    "GRCON_TEAMS_CONVERSATION_ID": "19:000ba02b2d5a4f46b9b745319994ab9e@thread.v2"
  },
  "r2_buckets": [
    {
      "binding": "GRCON_DOCUMENTS",
      "bucket_name": "grcon-documents"
    }
  ],
  "triggers": {
    "crons": [
      "17 5 * * *",
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}


