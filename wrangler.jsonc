{
  "name": "grcon-cloudflare",
  "compatibility_date": "2026-09-24",
  "main": "./cloudflare/worker.mjs",
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
